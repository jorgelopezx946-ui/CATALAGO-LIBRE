# Copia este archivo como .env.local cuando se integre el cliente Supabase.
# Usa únicamente la URL del proyecto y la clave anon/public en el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLIC
# NUNCA colocar SUPABASE_SERVICE_ROLE_KEY aquí ni en Web/EXE/APK.
